# Copy this file to .env and edit it before running install.sh.
# The file is sourced by /bin/sh. Keep values shell-safe.

# Docker context created on the Mac.
DOCKER_CONTEXT_NAME=arm-companion

# ARM Linux host reachable from the Mac. Prefer mDNS or DNS over raw DHCP IPs.
COMPANION_HOST=armbox.local
COMPANION_USER=
COMPANION_SSH_ALIAS=arm-companion
COMPANION_SSH_IDENTITY_FILE=

# Optional direct endpoint. Leave empty to use ssh:// via COMPANION_HOST.
# Example, SSH: COMPANION_DOCKER_ENDPOINT=ssh://user@armbox.local
# Example, opt-in LAN proxy: COMPANION_DOCKER_ENDPOINT=tcp://armbox.local:23750
COMPANION_DOCKER_ENDPOINT=

# Mac setup.
INSTALL_HOMEBREW=0
WRITE_SHELL_PROFILE=0
START_COLIMA=0
COLIMA_CPU=4
COLIMA_MEMORY=8
COLIMA_DISK=60

# Optional macOS NFS export for project bind mounts on the companion.
ENABLE_MAC_NFS_EXPORT=0
MAC_NFS_EXPORT_PATH=/Users/you/Repositories/project
MAC_NFS_CLIENTS=armbox.local

# Companion Docker setup.
DOCKER_APT_OS=
DOCKER_APT_SUITE=
CONFIGURE_DOCKER_DAEMON=1
COMPANION_DOCKER_DATA_ROOT=/var/lib/docker
DOCKER_LOG_MAX_SIZE=100m
DOCKER_LOG_MAX_FILE=3

# Optional persistent storage mount for USB/NVMe SSDs.
CONFIGURE_STORAGE_MOUNT=0
COMPANION_STORAGE_UUID=
COMPANION_STORAGE_MOUNT=/mnt/companion-ssd
COMPANION_STORAGE_FSTYPE=ext4

# Optional Avahi/mDNS fix. On Rockchip boards this is often end0.
ENABLE_AVAHI_FIX=0
AVAHI_ALLOW_INTERFACES=end0

# Optional Mac repository export mounted by the companion via NFS.
ENABLE_NFS_CLIENT=0
NFS_SERVER=mac.local
NFS_EXPORT=/Users/you/Repositories/project
NFS_MOUNT=/Users/you/Repositories/project

# Optional Docker socket TCP proxy. SSH contexts are safer and are the default.
ENABLE_LAN_DOCKER_PROXY=0
DOCKER_PROXY_BIND=0.0.0.0
DOCKER_PROXY_PORT=23750
DOCKER_PROXY_ALLOW_CIDR=

# Buildx.
CREATE_BUILDX_BUILDER=1
BUILDX_BUILDER_NAME=

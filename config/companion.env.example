# Copy this file to .env and edit it before running install.sh.
# The file is sourced by /bin/sh. Keep values shell-safe.

# Docker context created on the Mac.
DOCKER_CONTEXT_NAME=arm-companion

# ARM Linux host reachable from the Mac. Prefer mDNS or DNS over raw DHCP IPs.
COMPANION_HOST=armbox.local
# Optional fallback hosts/IPs when DNS or mDNS is stale. Space-separated.
COMPANION_HOST_FALLBACKS=
COMPANION_USER=
COMPANION_SSH_ALIAS=arm-companion
# Optional host/IP written into the Mac SSH alias instead of COMPANION_HOST.
COMPANION_SSH_HOST=
COMPANION_SSH_IDENTITY_FILE=

# Optional direct endpoint. Leave empty to use ssh:// via COMPANION_HOST.
# Example, SSH: COMPANION_DOCKER_ENDPOINT=ssh://user@armbox.local
# Example, opt-in LAN proxy: COMPANION_DOCKER_ENDPOINT=tcp://armbox.local:23750
# When COMPANION_HOST_FALLBACKS is set and this endpoint uses COMPANION_HOST,
# mac-dev-tunnels will also try equivalent endpoints with each fallback host.
COMPANION_DOCKER_ENDPOINT=
# Optional full fallback endpoints for cases that cannot be derived from
# COMPANION_HOST_FALLBACKS, such as non-standard hostnames or ports.
COMPANION_DOCKER_ENDPOINT_FALLBACKS=

# Mac setup.
INSTALL_HOMEBREW=0
WRITE_SHELL_PROFILE=0
START_COLIMA=0
COLIMA_CPU=4
COLIMA_MEMORY=8
COLIMA_DISK=60

# Optional macOS NFS export for project bind mounts on the companion.
ENABLE_MAC_NFS_EXPORT=0
MAC_NFS_EXPORT_PATH=/Users/you/Repositories/project
MAC_NFS_CLIENTS=armbox.local

# Companion Docker setup.
DOCKER_APT_OS=
DOCKER_APT_SUITE=
CONFIGURE_DOCKER_DAEMON=1
COMPANION_DOCKER_DATA_ROOT=/var/lib/docker
DOCKER_LOG_MAX_SIZE=100m
DOCKER_LOG_MAX_FILE=3

# Optional persistent storage mount for USB/NVMe SSDs.
CONFIGURE_STORAGE_MOUNT=0
COMPANION_STORAGE_UUID=
COMPANION_STORAGE_MOUNT=/mnt/companion-ssd
COMPANION_STORAGE_FSTYPE=ext4

# Optional Avahi/mDNS fix. On Rockchip boards this is often end0.
ENABLE_AVAHI_FIX=0
AVAHI_ALLOW_INTERFACES=end0

# Optional Mac repository export mounted by the companion via NFS.
ENABLE_NFS_CLIENT=0
NFS_SERVER=mac.local
NFS_EXPORT=/Users/you/Repositories/project
NFS_MOUNT=/Users/you/Repositories/project

# Optional Docker socket TCP proxy. SSH contexts are safer and are the default.
ENABLE_LAN_DOCKER_PROXY=0
DOCKER_PROXY_BIND=0.0.0.0
DOCKER_PROXY_PORT=23750
DOCKER_PROXY_ALLOW_CIDR=

# Buildx.
CREATE_BUILDX_BUILDER=1
BUILDX_BUILDER_NAME=

# Optional Mac-side localhost tunnels for development tools while Docker runs
# on the companion. By default this mirrors every TCP host port published by
# running containers in DOCKER_CONTEXT_NAME onto Mac 127.0.0.1.
DEV_TUNNEL_AUTO_DOCKER_PORTS=1

# Optional extra forwards. Space-separated specs:
#   8080                 -> 127.0.0.1:8080 on Mac to 127.0.0.1:8080 on companion
#   8080:80              -> 127.0.0.1:8080 on Mac to 127.0.0.1:80 on companion
#   8080:container:80    -> 127.0.0.1:8080 on Mac to container:80 from companion
DEV_TUNNEL_FORWARDS=

# Optional generic project manifests. Each listed root may contain a
# .arm-docker-companion-tunnels file with one forward spec per line.
DEV_TUNNEL_PROJECT_ROOTS=
DEV_TUNNEL_MANIFEST_NAME=.arm-docker-companion-tunnels
DEV_TUNNEL_STOP_COLIMA_CONFLICTS=1
DEV_TUNNEL_SKIP_BUSY_PORTS=1
DEV_TUNNEL_SOFT_FAIL=1
DEV_TUNNEL_LAUNCHD_LABEL=com.arm-docker-companion.dev-tunnels
DEV_TUNNEL_LOG_DIR="$HOME/Library/Logs"
DEV_TUNNEL_LAUNCHD_PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
DEV_TUNNEL_DOCKER_CONFIG="$HOME/.docker"
DEV_TUNNEL_WATCH_INITIAL_SECONDS=5
DEV_TUNNEL_WATCH_MAX_SECONDS=60
DEV_TUNNEL_DOCKER_PROBE_TIMEOUT_SECONDS=5
